{
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/healthz",
      "rewrite": "/healthz.json",
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "application/json; charset=utf-8"
      }
    },
    {
      "route": "/deployment.json",
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "application/json; charset=utf-8"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/registerSW.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": {
        "Cache-Control": "public, max-age=300, must-revalidate"
      }
    },
    {
      "route": "/changelog.json",
      "headers": {
        "Cache-Control": "public, max-age=300, must-revalidate"
      }
    },
    {
      "route": "/deployment-assets.json",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Content-Type": "application/json; charset=utf-8"
      }
    },
    {
      "route": "/404.json",
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "application/json; charset=utf-8"
      }
    },
    {
      "route": "/favicon.svg",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/apple-touch-icon.svg",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/pwa-192x192.svg",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/pwa-512x512.svg",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/maskable-icon.svg",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/apple-touch-icon.png",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/pwa-192x192.png",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/pwa-512x512.png",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/maskable-icon.png",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/healthz", "/healthz.json", "/deployment.json", "/*.{js,css,ico,png,jpg,jpeg,webp,svg,woff,woff2}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.json",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "Cache-Control": "no-cache, must-revalidate",
    "Content-Security-Policy": "frame-ancestors 'self'",
    "Referrer-Policy": "same-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".css": "text/css",
    ".js": "text/javascript",
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}
