{
  "name": "cloudphoto",
  "private": true,
  "workspaces": [
    "packages/algorithm",
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "build": "yarn build:client && yarn build:server",
    "build:client": "yarn workspace cloudphoto-client build",
    "build:server": "yarn workspace cloudphoto-server build",
    "check:static-cache": "node scripts/check-static-cache-config.mjs",
    "dev:client": "yarn workspace cloudphoto-client dev",
    "dev:server": "yarn workspace cloudphoto-server start",
    "test:photo-loading-contracts": "node packages/client/src/services/videoCoverRepairPolicy.test.mjs && node scripts/check-photo-loading-contracts.mjs",
    "test:whats-new-accessibility": "node --test packages/client/src/components/whats-new/WhatsNewPopup.test.mjs",
    "test:pwa-install": "node --test packages/client/src/pwa/installPrompt.test.mjs",
    "test:workflow-contracts": "node --test scripts/workflow-runtime-contracts.test.mjs && node scripts/check-workflow-runtime-contracts.mjs",
    "change": "node scripts/create-change.mjs",
    "changes:collect": "node scripts/collect-changes.mjs",
    "test:production-smoke": "node --test scripts/production-smoke.test.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  }
}
