{
  "name": "cloudphoto",
  "private": true,
  "workspaces": [
    "packages/algorithm",
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "build": "yarn build:client && yarn build:server",
    "build:client": "yarn workspace cloudphoto-client build",
    "build:server": "yarn workspace cloudphoto-server build",
    "check:static-cache": "node scripts/check-static-cache-config.mjs",
    "dev:client": "yarn workspace cloudphoto-client dev",
    "dev:server": "yarn workspace cloudphoto-server start",
    "test:video-playback": "node --test packages/client/src/services/videoPlaybackSession.test.mjs packages/client/src/services/videoPlaybackCoverCapture.test.mjs",
    "test:photo-loading-contracts": "node packages/client/src/services/videoCoverRepairPolicy.test.mjs && node scripts/check-photo-loading-contracts.mjs",
    "test:private-data": "node scripts/private-local-data.test.mjs",
    "test:private-cache-lazy": "node --test scripts/private-cache-lazy-contract.test.mjs",
    "test:mobile-layout-contracts": "node --test scripts/mobile-layout-contracts.test.mjs scripts/mobile-controls-date-contracts.test.mjs scripts/photo-preview-modal-contracts.test.mjs packages/client/src/components/gallery/FilterBar.debounce.test.mjs packages/client/src/components/home/WorkspaceSidebar.keyboard.test.mjs",
    "test:mobile-controls-dates": "node --test scripts/mobile-controls-date-contracts.test.mjs",
    "test:mobile-touch-targets": "node --test scripts/mobile-touch-targets.test.mjs",
    "test:workspace-tabs": "node --test packages/client/src/keyboard/workspaceTabs.test.mjs",
    "test:sidebar-filter-layout": "node --test scripts/sidebar-filter-layout-contracts.test.mjs",
    "test:sidebar-accessibility": "node --test packages/client/src/components/home/WorkspaceSidebar.keyboard.test.mjs",
    "test:header-accessibility": "node --test packages/client/src/components/shared/menuKeyboard.test.mjs packages/client/src/components/groups/HeaderAutoHide.test.mjs packages/client/src/components/groups/HeaderMenusAccessibility.test.mjs packages/client/src/components/auth/UserMenuDialogsAccessibility.test.mjs",
    "test:auth-validation": "node --test packages/client/src/components/auth/nativeValidation.test.mjs",
    "test:login-recovery": "node --test packages/client/src/services/loginProxyRecovery.test.mjs",
    "test:memory-map-locations": "node --test packages/client/src/components/memory-map/memoryMapLocationPartitions.test.mjs packages/client/src/photoGpsState.test.mjs",
    "test:auth-layout": "node --test scripts/auth-layout-contracts.test.mjs",
    "test:auth-layout-cdp": "node scripts/auth-layout-cdp.mjs",
    "test:authenticated-dates": "node --test scripts/authenticated-date-contracts.test.mjs",
    "test:whats-new-accessibility": "node --test packages/client/src/components/whats-new/WhatsNewPopup.test.mjs",
    "test:pwa-install": "node --test packages/client/src/pwa/installPrompt.test.mjs",
    "test:pwa-update": "node --test packages/client/src/pwa/updatePolicy.test.mjs packages/client/src/pwa/deploymentRecovery.test.mjs packages/client/src/pwa/dangerousOperationGate.test.mjs",
    "test:deployment-assets": "node --test --test-force-exit scripts/deployment-asset-retention.test.mjs scripts/stale-deployment-browser.test.mjs",
    "test:workflow-contracts": "node --test scripts/workflow-runtime-contracts.test.mjs && node scripts/check-workflow-runtime-contracts.mjs",
    "test:security": "node --test scripts/security-headers.test.mjs",
    "change": "node scripts/create-change.mjs",
    "changes:collect": "node scripts/collect-changes.mjs",
    "test:production-smoke": "node --test scripts/production-smoke.test.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  }
}
